# Local/hybrid defaults. Do not put production secrets in this file.
SAP_DESTINATION=ABAP_TOOL_CC
SAP_HTTP_TIMEOUT_MS=45000
IGRID_COMPAT_PROXY=true

# Optional override only if the iGrid notification catalog keeps the old A2X URL
# but the client system exposes the OData V2 API instead.
SAP_NOTIFICATION_LEGACY_BASE=/sap/opu/odata/sap/API_MAINTNOTIFICATION

# Connection test endpoints
SAP_METADATA_PATH=/sap/opu/odata/sap/API_MAINTENANCEORDER/$metadata
SAP_DATA_PROBE_PATH=/sap/opu/odata/sap/API_MAINTENANCEORDER/MaintenanceOrder?$format=json&$top=1
